<div>\begin{equation}  \begin{gathered}\label{equation:diagram-of-collapse} \xymatrix@R =50pt@C=50pt{ (X \times \{ 0 \}  \times Y) \coprod (X \times \{ 1\}  \times Y) \ar [r] \ar [d]^{\pi _{X} \coprod \pi _{Y}} &amp;  X \times \Delta ^1 \times Y \ar [d]^{c} \\ ( X \times \{ 0\}  ) \coprod ( \{ 1\}  \times Y ) \ar [r]^-{( \iota _{X}, \iota _{Y} )} &amp;  X \star Y} \end{gathered} \end{equation}</div>
</div>
