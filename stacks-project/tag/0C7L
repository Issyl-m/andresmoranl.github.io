  \[  (\frac{a_{ij}^2}{w_ iw_ j}, \frac{a_{jk}^2}{w_ jw_ k}, \frac{a_{kl}^2}{w_ kw_ l}, \frac{a_{il}^2}{w_ iw_ l}) = (1, 1, 1, 0), (1, 1, 2, 0), (1, 2, 1, 0), \text{ or }(2, 1, 1, 0)  \]
</div>
<p>
